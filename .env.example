# PeopleFlow HCM Environment Configuration
# Copy this file to .env.local for local overrides

# Application Environment
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Provider ('mock' or 'postgres')
DATABASE_PROVIDER=mock
# DATABASE_URL=postgresql://postgres:password@localhost:5432/peopleflow_dev?schema=public

# Authentication Provider ('mock' or 'supabase')
AUTH_PROVIDER=mock
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Storage Provider ('mock' or 's3')
STORAGE_PROVIDER=mock
